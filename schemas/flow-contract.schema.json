{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zqpiggy-wow/interaction-flow-kit/main/schemas/flow-contract.schema.json",
  "title": "Interaction Flow Contract",
  "description": "A compact, implementation-oriented contract for a non-trivial user flow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "intent", "flow"],
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "desired_change", "completion"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "stated_means": { "type": "string", "minLength": 1 },
        "desired_change": { "type": "string", "minLength": 1 },
        "completion": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "steps", "continuation"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "continuation": { "type": "string", "minLength": 1 },
        "recovery": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery" }
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owners": {
          "type": "array",
          "items": { "$ref": "#/$defs/owner" }
        },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/interface" }
        },
        "data_flows": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataFlow" }
        },
        "data_objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataObject" }
        },
        "data_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataBinding" }
        },
        "implementation_path": {
          "anyOf": [
            { "$ref": "#/$defs/implementationPath" },
            { "type": "null" }
          ]
        },
        "invariants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "verification": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["reads"], "properties": { "reads": { "minItems": 1 } } },
              { "required": ["writes"], "properties": { "writes": { "minItems": 1 } } }
            ]
          },
          "then": { "required": ["data_boundary"] }
        }
      ],
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "actor": { "type": "string", "minLength": 1 },
        "data_boundary": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "action": { "type": "string", "minLength": 1 },
        "system_effect": { "type": "string", "minLength": 1 },
        "feedback": { "type": "string", "minLength": 1 },
        "next": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reads": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "behavior"],
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "behavior": { "type": "string", "minLength": 1 },
        "preserves": { "type": "string", "minLength": 1 }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concern", "owner", "source_of_truth"],
      "properties": {
        "concern": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source_of_truth": { "type": "string", "minLength": 1 }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "contract"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "failure_semantics": { "type": "string", "minLength": 1 }
      }
    },
    "dataFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "from", "to", "purpose"],
      "properties": {
        "data": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 },
        "failure": { "type": "string", "minLength": 1 }
      }
    },
    "dataObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "identity", "owner", "source_of_truth"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "kind": {
          "type": "string",
          "enum": ["operation", "result", "dataset", "record", "configuration", "artifact"]
        },
        "identity": { "type": "string", "minLength": 1 },
        "produced_by": { "type": "string", "minLength": 1 },
        "external_source": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source_of_truth": { "type": "string", "minLength": 1 },
        "user_projection": { "type": "string", "minLength": 1 },
        "internal_purpose": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "minLength": 1 }
      }
    },
    "implementationPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "strategy", "entries", "converges_at", "state_machine", "state_owner", "side_effect_owner", "inspected_paths", "removed_paths", "negative_searches", "authority_tests", "verification"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "strategy": { "type": "string", "enum": ["evolve-in-place", "replace"] },
        "entries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "converges_at": { "type": "string", "minLength": 1 },
        "state_machine": { "type": "string", "minLength": 1 },
        "state_owner": { "type": "string", "minLength": 1 },
        "side_effect_owner": { "type": "string", "minLength": 1 },
        "inspected_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "removed_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "negative_searches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "authority_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "replace" } }, "required": ["strategy"] },
          "then": { "properties": { "removed_paths": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "strategy": { "const": "evolve-in-place" } }, "required": ["strategy"] },
          "then": { "properties": { "removed_paths": { "maxItems": 0 } } }
        }
      ]
    },
    "dataBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_step", "to_step", "binding"],
      "properties": {
        "from_step": { "type": "string", "minLength": 1 },
        "to_step": { "type": "string", "minLength": 1 },
        "data_object": { "type": "string", "minLength": 1 },
        "binding": {
          "type": "string",
          "enum": ["inherit-current", "select-compatible", "optional", "independent"]
        },
        "request_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "response_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "selection_query": { "type": "string", "minLength": 1 },
        "compatibility": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "provenance": { "type": "string", "minLength": 1 },
        "correction": { "type": "string", "minLength": 1 },
        "staleness": { "type": "string", "minLength": 1 },
        "empty_behavior": { "type": "string", "minLength": 1 }
      }
    }
  }
}
